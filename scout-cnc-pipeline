## 8. Key Types Reference

### ToolConfig and LayerConfig (Frontend, `tool-defaults.ts`)

```typescript
interface LayerConfig {
  depth: number;   // Cutting depth (negative, e.g. -4.1)
  offset: number;  // Tool offset (e.g. 3.0)
}

interface ToolConfig {
  id: string;            // e.g. "prav"
  name: string;          // e.g. "End Mill"
  number: number;        // e.g. 7
  diameter: number;      // mm
  gauge_length: number;  // mm
  flutes: number;
  spindle_rpm: number;
  feed_cut: number;      // mm/min
  feed_plunge: number;   // mm/min
  tip_radius?: number;   // for tapered tools
  taper_angle?: number;
  taper_height?: number;
  layers: Record<string, LayerConfig>;  // e.g. { CUT: {depth: -4.1, offset: 3.0} }
}
```

### Segment (Frontend, `types.ts`)

```typescript
interface Segment {
  x1: number; y1: number;   // Start point
  x2: number; y2: number;   // End point
  layer: string;             // Layer name (CUT, FREZ, etc.)
  seq_index: number;         // Global cutting sequence order (0-based)
}
```

### PageState (Frontend, `types.ts`)

```typescript
type PageState =
  | { status: "idle" }
  | { status: "uploading" }
  | { status: "ready"; jobId: string; generate: GenerateResponse; geometry: GeometryResponse }
  | { status: "generating"; jobId: string; generate: GenerateResponse; geometry: GeometryResponse }
  | { status: "done"; jobId: string; generate: GenerateResponse; geometry: GeometryResponse; ncText: string }
  | { status: "error"; message: string }
```

